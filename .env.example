# ============================================================
# Clarity POS - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# Django Security
SECRET_KEY=your-django-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# PostgreSQL Database Configuration
DB_NAME=clarity_pos
DB_USER=pos_user
DB_PASSWORD=pos_password_change_me
DB_HOST=db
DB_PORT=5432

# Docker Registry Configuration
DOCKER_REGISTRY=tinashemp
TAG=latest

# Sentry Monitoring (Optional)
SENTRY_DSN=

# ZIMRA Fiscalisation (Optional / If applicable)
ZIMRA_DEVICE_ID=
ZIMRA_SERIAL_NO=
ZIMRA_ACTIVATION_KEY=
ZIMRA_TEST_MODE=True
ZIMRA_COMPANY_NAME=
ZIMRA_MODEL_NAME=Server
ZIMRA_MODEL_VERSION=v1