# Django Settings
SECRET_KEY=must-change-this-to-a-unique-key-per-client
DEBUG=False
ALLOWED_HOSTS=*

# Database Settings (PostgreSQL)
DB_NAME=point_of_sale
DB_USER=pos_user
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# Time Zone
TIME_ZONE=America/New_York
#TIME_ZONE=Africa/Harare

# ZIMRA Settings
FISCAL_DEVICE_ID=10626
FISCAL_SERIAL_NO=9029D38C011B
FISCAL_ACTIVATION_KEY=00398834
FISCAL_TEST_MODE=False
FISCAL_COMPANY_NAME=YOUR COMPANY
FISCAL_MODEL_NAME=Server
FISCAL_MODEL_VERSION=v1

# Docker Registry Settings
# IMPORTANT: This is how the server knows where to get updates
DOCKER_REGISTRY=yourusername  # Your Docker Hub username
DOCKER_USERNAME=yourusername   # For private repos
DOCKER_PASSWORD=your-docker-password-or-token  # For private repos

# Update Settings
UPDATE_CHECK_ENABLED=true
UPDATE_INTERVAL=86400  # 24 hours in seconds
UPDATE_TAG=latest      # or specific version like v1.2.3