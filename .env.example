# Django Settings
# IMPORTANT: Generate a UNIQUE secret key for EACH client installation
# To generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=must-change-this-to-a-unique-key-per-client

# Set to False for production
DEBUG=False

# Comma-separated list of allowed hosts (use * for any host on local network)
ALLOWED_HOSTS=*

# Database Settings (PostgreSQL)
DB_NAME=point_of_sale
DB_USER=pos_user
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=hkjlkjhvhjljkjhkjkkvcgcgkhjnb,m

# Time Zone (find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIME_ZONE=America/New_York

# Environment name
ENVIRONMENT=production

# Sentry Error Tracking (optional - leave blank if not using)
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1


