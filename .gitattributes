# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare shell scripts to always use LF (vital for Docker/Linux)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar binary
*.zip binary
*.pyc binary
